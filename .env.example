# Postgres — Docker Compose reads these to init the DB.
POSTGRES_USER=jira
POSTGRES_PASSWORD=jira
POSTGRES_DB=jira
POSTGRES_PORT=5432

# API — Drizzle/Express read this.
DATABASE_URL=postgres://jira:jira@localhost:5432/jira
API_PORT=3000

# Web — Vite dev server.
WEB_PORT=5173

# Compose project name — per-worktree namespacing (see build-plan gotcha 4).
COMPOSE_PROJECT_NAME=jiralite
